{
  "name": "@gattlab/cdp",
  "version": "0.1.0-beta",
  "description": "Chromium CDP backend for GattLab.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",

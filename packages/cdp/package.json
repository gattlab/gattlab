      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@gattlab/core": "workspace:*",
    "devtools-protocol": "0.0.1674729"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gattlab/gattlab.git",
    "directory": "packages/cdp"
  },
  "homepage": "https://github.com/gattlab/gattlab/tree/main/packages/cdp#readme",
  "bugs": {
    "url": "https://github.com/gattlab/gattlab/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
